# Copy this file to .env.local and put secrets there.
# .env.local is gitignored and must not be pasted into chat.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
MAIL_FROM=
APP_URL=
STAFF_URL=
# HMAC key for invite links and device secrets. Put the value in .env.local only.
TOKEN_PEPPER=
# Temporary Gmail SMTP until the application domain is verified on Resend.
# mail_test is the Gmail address. mail_password is an app password, not the account password.
# When both are set, mail goes through Gmail. Remove both to return to Resend.
mail_test=
mail_password=
